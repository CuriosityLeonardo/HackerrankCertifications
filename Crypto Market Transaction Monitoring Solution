-- Use Common Table Expressions (CTEs) for a clear, step-by-step approach.
WITH time_differences AS (
    -- Step 1: Calculate the time difference in SECONDS between consecutive transactions
    -- for each sender. Using seconds is more precise than minutes.
    SELECT
        sender,
        amount,
        CAST(dt AS DATETIME) AS transaction_time,
        -- Use TIMESTAMPDIFF with SECOND to avoid truncation issues.
        TIMESTAMPDIFF(
            SECOND,
            LAG(CAST(dt AS DATETIME), 1) OVER (PARTITION BY sender ORDER BY CAST(dt AS DATETIME)),
            CAST(dt AS DATETIME)
        ) AS seconds_since_last
    FROM
        transactions
),

sequence_identifier AS (
    -- Step 2: Identify each new sequence. A sequence starts when the time gap
    -- is more than 3600 seconds (1 hour).
    SELECT
        sender,
        amount,
        transaction_time,
        -- Create a unique 'sequence_id' for each group using a running sum.
        SUM(CASE WHEN seconds_since_last > 3600 OR seconds_since_last IS NULL THEN 1 ELSE 0 END)
            OVER (PARTITION BY sender ORDER BY transaction_time) AS sequence_id
    FROM
        time_differences
)

-- Step 3: Group transactions by their sequence_id and calculate the required aggregates.
SELECT
    sender,
    MIN(transaction_time) AS sequence_start,
    MAX(transaction_time) AS sequence_end,
    COUNT(*) AS transactions_count,
    SUM(amount) AS transactions_sum
FROM
    sequence_identifier
GROUP BY
    sender,
    sequence_id
HAVING
    -- Step 4: Apply the two conditions for a sequence to be suspicious.
    COUNT(*) >= 2 AND SUM(amount) >= 150
ORDER BY
    sender,
    sequence_start,
    sequence_end;
